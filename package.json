{
  "name": "cliptalk-highlight-director",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "doctor": "python3 tools/doctor.py",
    "validate:workflows": "python3 tools/validate_workflows.py",
    "evaluate:workflow-intent": "python3 tools/evaluate_workflow_intent.py",
    "check:repository": "python3 tools/check_repository.py",
    "check:deployment": "python3 tools/check_repository.py --mode deployment",
    "lint": "npm run lint:frontend && npm run lint:python",
    "lint:frontend": "eslint static/api-client.js static/app-shell.js static/app.js static/review-actions.js static/runtime-errors.js static/task-creation.js static/ui-copy.js static/workspace-state.js",
    "lint:python": "ruff check app tools --select F811,F821,F822,F823",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "test:intent": "python3 -m pytest -q tests/test_intent_logic.py",
    "benchmark:quality": "python3 tools/evaluate_algorithm_v2.py benchmarks/algorithm-v2-evaluation.jsonl --check --require-input",
    "benchmark:algorithm-v2": "python3 tools/evaluate_algorithm_v2.py benchmarks/algorithm-v2-evaluation.jsonl --check --require-input",
    "benchmark:interview-quality": "python3 tools/evaluate_content_search.py benchmarks/interview-content-search.jsonl --check --strict-interview --require-input",
    "build:readme-preview": "node tools/build-readme-preview.mjs",
    "preview:readme": "npm run build:readme-preview && python3 -m http.server 5191 --bind 0.0.0.0",
    "build:orbs": "vite build --config vite.orbs.config.js",
    "build:loaders": "vite build --config vite.loaders.config.js",
    "build:beam": "vite build --config vite.beam.config.js",
    "build:icons": "vite build --config vite.icons.config.js",
    "build:ui-runtime": "npm run build:orbs && npm run build:loaders && npm run build:beam && npm run build:icons"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "border-beam": "^1.3.0",
    "generative-loaders": "^0.1.1",
    "preact": "^10.27.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "thinking-orbs": "^0.2.0"
  },
  "devDependencies": {
    "@primer/css": "^22.3.0",
    "@primer/octicons": "^19.33.0",
    "eslint": "^10.8.1",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "vite": "^8.2.0"
  }
}

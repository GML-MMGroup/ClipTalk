{
  "name": "cliptalk-highlight-director",
  "private": true,
  "type": "module",
  "scripts": {
    "build:readme-preview": "node tools/build-readme-preview.mjs",
    "preview:readme": "npm run build:readme-preview && python3 -m http.server 5191 --bind 0.0.0.0",
    "build:orbs": "vite build --config vite.orbs.config.js",
    "build:loaders": "vite build --config vite.loaders.config.js",
    "build:beam": "vite build --config vite.beam.config.js",
    "build:icons": "vite build --config vite.icons.config.js",
    "build:ui-runtime": "npm run build:orbs && npm run build:loaders && npm run build:beam && npm run build:icons"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "border-beam": "^1.3.0",
    "generative-loaders": "^0.1.1",
    "preact": "^10.27.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "thinking-orbs": "^0.2.0"
  },
  "devDependencies": {
    "@primer/css": "^22.3.0",
    "@primer/octicons": "^19.33.0",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "vite": "^8.2.0"
  }
}

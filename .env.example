# 通用视觉模型配置：支持 OpenAI Chat Completions 兼容的多模态接口
# provider 可填 ark、openai、openai_compatible 或自定义服务名称
VISION_PROVIDER=ark
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=
# 非方舟兼容接口通常留空；方舟可填 disabled、enabled 或 auto
VISION_THINKING_TYPE=
# 支持 json_object 的接口保持默认；不支持时改为 none
VISION_RESPONSE_FORMAT=json_object
VISION_TIMEOUT_SECONDS=90

# 旧版火山方舟配置仍受支持；VISION_* 留空时自动回退到这里
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_THINKING_TYPE=disabled
ARK_TIMEOUT_SECONDS=90

# 可选：文本 LLM 剪辑规划配置；也可在界面中选择复用视觉配置或独立配置
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_THINKING_TYPE=disabled
LLM_TIMEOUT_SECONDS=60

# 可选：方舟 Anthropic 兼容接口（配置完整后优先于 LLM_*）
ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/compatible
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# 独立服务配置
# 本机安全默认值；容器或远程部署可改为 0.0.0.0，并应同时配置访问令牌
HIGHLIGHT_HOST=127.0.0.1
HIGHLIGHT_PORT=5180
# 上传、缓存、模型和输出的本地存储目录
HIGHLIGHT_DATA_ROOT=./data
HIGHLIGHT_MAX_WORKERS=1
HIGHLIGHT_MAX_UPLOAD_BYTES=8589934592
# 全部任务数据的磁盘上限（默认 50 GiB）
HIGHLIGHT_MAX_STORAGE_BYTES=53687091200
# 0 表示不自动清理；正整数表示清理超过该天数且未置顶的任务
HIGHLIGHT_RETENTION_DAYS=0
# 非回环地址必须启用至少 16 字符的 API 访问令牌；浏览器会安全地提示输入
HIGHLIGHT_ACCESS_TOKEN=
# 默认禁止模型接口指向本机、内网或云元数据地址；仅可信的本地模型部署可显式开启
HIGHLIGHT_ALLOW_PRIVATE_MODEL_ENDPOINTS=false
# JSON 结构化日志级别：DEBUG、INFO、WARNING 或 ERROR
HIGHLIGHT_LOG_LEVEL=INFO
# restart.sh 的日志输出路径；留空时使用项目根目录下的 vlm-highlight.log
HIGHLIGHT_LOG_FILE=./vlm-highlight.log
# 富语音分析：默认 SenseVoiceSmall + VAD + 标点 + CAM++ 说话人分段
HIGHLIGHT_SPEECH_ENGINE=sensevoice
HIGHLIGHT_SENSEVOICE_MODEL=iic/SenseVoiceSmall
HIGHLIGHT_SENSEVOICE_DEVICE=auto
HIGHLIGHT_SENSEVOICE_VAD_MODEL=fsmn-vad
# SenseVoice 自带标点；留空可避免额外下载约 1.1 GiB 的 CT-Punc
HIGHLIGHT_SENSEVOICE_PUNC_MODEL=
HIGHLIGHT_SENSEVOICE_SPK_MODEL=cam++
HIGHLIGHT_SENSEVOICE_DIARIZATION=false
HIGHLIGHT_SPEECH_MODEL_CACHE=./data/models
# 可选 Whisper 回退；留空时 SenseVoice 失败会暂停并让用户决定
HIGHLIGHT_WHISPER_MODEL=
HIGHLIGHT_WHISPER_DEVICE=auto
# 新建内容剪辑任务使用的 v4 多模态识别；旧任务不会迁移
HIGHLIGHT_RECOGNITION_V4=true
# 对话图检索开关；仅排障或回滚时设为 false
CONTENT_SEARCH_DIALOGUE_V2=true
HIGHLIGHT_RECOGNITION_PROFILE=auto
HIGHLIGHT_RECOGNITION_MODEL_CACHE=./data/models/recognition
HIGHLIGHT_OCR_ENABLED=true
HIGHLIGHT_TEXT_EMBEDDING_MODEL=intfloat/multilingual-e5-base
HIGHLIGHT_SIGLIP_MODEL=google/siglip2-base-patch16-224
HIGHLIGHT_CLAP_MODEL=laion/clap-htsat-fused
HIGHLIGHT_GROUNDING_MODEL=IDEA-Research/grounding-dino-tiny
HIGHLIGHT_YUNET_MODEL=./data/models/recognition/face_detection_yunet_2023mar.onnx
HIGHLIGHT_SFACE_MODEL=./data/models/recognition/face_recognition_sface_2021dec.onnx
# 可指向安装了可选识别依赖的独立 Python；留空则在任务线程内按需加载
HIGHLIGHT_RECOGNITION_PYTHON=
# 可选：TalkNet 主动说话人检测使用隔离 Python 环境。shadow 只记录对比，
# primary 仅应在本地验证集达标后启用；未配置完整时自动保留现有 VLM 复核。
HIGHLIGHT_ACTIVE_SPEAKER_MODE=primary
HIGHLIGHT_TALKNET_PYTHON=
HIGHLIGHT_TALKNET_WORKER=./tools/talknet_worker.py
HIGHLIGHT_TALKNET_REPOSITORY=
HIGHLIGHT_TALKNET_CHECKPOINT=
HIGHLIGHT_TALKNET_DEVICE=cuda:0
HIGHLIGHT_TALKNET_TIMEOUT_SECONDS=900
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe

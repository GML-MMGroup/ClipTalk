# 通用视觉模型配置：支持 OpenAI Chat Completions 兼容的多模态接口
# provider 可填 ark、openai、openai_compatible 或自定义服务名称
VISION_PROVIDER=ark
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=
# 非方舟兼容接口通常留空；方舟可填 disabled、enabled 或 auto
VISION_THINKING_TYPE=
# 支持 json_object 的接口保持默认；不支持时改为 none
VISION_RESPONSE_FORMAT=json_object
VISION_TIMEOUT_SECONDS=90

# 旧版火山方舟配置仍受支持；VISION_* 留空时自动回退到这里
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_THINKING_TYPE=disabled
ARK_TIMEOUT_SECONDS=90

# 可选：文本 LLM 剪辑规划配置；也可在界面中选择复用视觉配置或独立配置
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_THINKING_TYPE=disabled
LLM_TIMEOUT_SECONDS=60

# 可选：方舟 Anthropic 兼容接口（配置完整后优先于 LLM_*）
ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/compatible
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# 独立服务配置
# 本机安全默认值；容器或远程部署可改为 0.0.0.0，并应同时配置访问令牌
HIGHLIGHT_HOST=127.0.0.1
HIGHLIGHT_PORT=5180
# Docker Compose 对宿主机发布的地址和端口；默认只允许本机访问
CLIPTALK_ENV_FILE=.env
CLIPTALK_BIND_ADDRESS=127.0.0.1
CLIPTALK_PORT=5180
# 上传、缓存、模型和输出的本地存储目录
HIGHLIGHT_DATA_ROOT=./data
HIGHLIGHT_MAX_WORKERS=1
HIGHLIGHT_MAX_UPLOAD_BYTES=8589934592
# 全部任务数据的磁盘上限（默认 50 GiB）
HIGHLIGHT_MAX_STORAGE_BYTES=53687091200
# 0 表示不自动清理；正整数表示清理超过该天数且未置顶的任务
HIGHLIGHT_RETENTION_DAYS=0
# 可选：启用 API 访问令牌；浏览器首次访问可使用 /?token=该值
HIGHLIGHT_ACCESS_TOKEN=
# 富语音分析：默认 SenseVoiceSmall + VAD + 标点 + CAM++ 说话人分段
HIGHLIGHT_SPEECH_ENGINE=sensevoice
HIGHLIGHT_SENSEVOICE_MODEL=iic/SenseVoiceSmall
HIGHLIGHT_SENSEVOICE_DEVICE=auto
HIGHLIGHT_SENSEVOICE_VAD_MODEL=fsmn-vad
# SenseVoice 自带标点；留空可避免额外下载约 1.1 GiB 的 CT-Punc
HIGHLIGHT_SENSEVOICE_PUNC_MODEL=
HIGHLIGHT_SENSEVOICE_SPK_MODEL=cam++
HIGHLIGHT_SENSEVOICE_DIARIZATION=false
HIGHLIGHT_SPEECH_MODEL_CACHE=./data/models
# 可选 Whisper 回退；留空时 SenseVoice 失败会暂停并让用户决定
HIGHLIGHT_WHISPER_MODEL=
HIGHLIGHT_WHISPER_DEVICE=auto
# 留空时自动从 PATH 查找；仅在自定义安装位置时填写绝对路径
FFMPEG_BIN=
FFPROBE_BIN=

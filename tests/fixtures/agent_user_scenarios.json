      "expectedOutcome": "graceful_no_match",
      "expectedSkillAnyOf": ["cliptalk-content-extractor"],
      "expectedTerms": ["手机芯片", "跑分"],
      "targetDuration": {"minimum": 27, "maximum": 33}
    },

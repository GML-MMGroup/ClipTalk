{
  "schemaVersion": 1,
  "defaults": {
    "executionMode": "autonomous_review",
    "phaseTimeoutSeconds": 1800,
    "stallSeconds": 180,
    "pollIntervalSeconds": 2,
    "durationToleranceRatio": 0.1
  },
  "scenarios": [
    {
      "id": "product-appliance-replacement",
      "video": "cest-video/产品宣传.mp4",
      "kind": "normal",
      "prompt": "分别找出冰箱、空调、洗衣机的新旧更换过程，每类约 20 秒，组合成 60±6 秒视频；生成 9:16 审核预览并质检，正式导出另行确认。",
      "expectedOutcome": "preview_or_clear_limitation",
      "expectedSkillAnyOf": ["cliptalk-content-extractor"],
      "expectedTerms": ["冰箱", "空调", "洗衣机"],
      "targetDuration": {"minimum": 54, "maximum": 66},
      "expectedAspect": "9:16"
    },
    {
      "id": "product-impossible-phone-chip",
      "video": "cest-video/产品宣传.mp4",
